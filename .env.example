# ================================
# AI Radar — Variables de Entorno
# ================================
# Copia este archivo a .env.local y completa los valores.
# .env.local esta en .gitignore — NUNCA comitees secretos.

# --- Supabase (Frontend - seguro para navegador) ---
SUPABASE_URL=https://luymyxnbfieuelbsaqzv.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-aqui

# --- Supabase (Server-side - NO exponer en frontend) ---
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# --- API Token (Server-side - necesario para guardar señales) ---
AI_RADAR_SAVE_TOKEN=tu-token-de-guardado-aqui

# --- Configuracion General ---
AI_RADAR_DEFAULT_TIMEZONE=America/Bogota
